// Agency OS
// Phase 1: Agency + Client management.
// Phase 2: the content pipeline — one record per video, tracked end to end
//          (Plan -> Script -> Approve -> Shoot -> Edit -> Ready -> Published).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the app.
  url       = env("DATABASE_URL")
  // Direct connection, used for migrations.
  directUrl = env("DIRECT_URL")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  clients      Client[]
  members      Member[]
  contentItems ContentItem[]
}

model Client {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name      String
  industry  String?
  status    String  @default("active") // active | paused | archived
  accent    String  @default("violet")

  contactName  String?
  contactEmail String?
  contactPhone String?

  monthlyTarget     Int @default(0) // videos / month
  monthlyPostTarget Int @default(0) // posts / month, tracked separately from video output
  retainer      Int    @default(0)
  services      String @default("")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contentItems ContentItem[]

  @@index([agencyId, status])
}

// The people who do the work — and the accounts they sign in with.
model Member {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  name   String
  // ceo | manager | scriptwriter | cameraman | editor | publisher
  role   String
  /// Sign-in address. Unique across the whole product, since sign-in doesn't ask for an agency.
  email  String? @unique
  accent String  @default("violet")
  active Boolean @default(true)

  // Sign-in. A member with no password has not accepted their invite yet.
  passwordHash    String?
  /// SHA-256 of the one-time invite token; the raw token only ever lives in the link.
  inviteTokenHash String?   @unique
  inviteExpires   DateTime?
  lastLoginAt     DateTime?
  sessions        Session[]

  // Pay. per_task earns `rate` per delivery; salary earns `salary` a month;
  // hybrid earns both. Whole rupees.
  payType String @default("per_task") // salary | per_task | hybrid
  rate    Int    @default(0)
  salary  Int    @default(0)
  payouts Payout[]

  createdAt DateTime @default(now())

  scriptTasks ContentItem[] @relation("scriptwriter")
  shootTasks  ContentItem[] @relation("cameraman")
  editTasks   ContentItem[] @relation("editor")
  postTasks   ContentItem[] @relation("publisher")

  @@index([agencyId, role])
}

/// One video, tracked from idea to published link.
model ContentItem {
  id       String @id @default(cuid())
  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Human-facing number, unique per agency — "Video #047".
  ref Int

  title    String
  idea     String?
  format   String  @default("reel") // reel | short | post | ad | longform
  priority String  @default("normal") // low | normal | high

  /// planned | scripting | script_review | shooting | editing | edit_review | ready | published
  stage    String @default("planned")
  monthKey String

  /// Overall "posted by" date. Mirrors publishDue; kept for sorting.
  dueDate DateTime?

  // The four-week cycle. Each step has its own deadline, worked out from the
  // week the cycle starts and adjustable per video.
  cycleStart        DateTime?
  scriptDue         DateTime? // week 1 — script written
  scriptApprovalDue DateTime? // week 1 — CEO approves the script
  shootDue          DateTime? // week 2 — shot and footage uploaded
  editDue           DateTime? // week 3 — edit complete
  finalApprovalDue  DateTime? // week 4 — CEO approves the final video
  publishDue        DateTime? // week 4 — posted

  scriptwriterId String?
  scriptwriter   Member? @relation("scriptwriter", fields: [scriptwriterId], references: [id], onDelete: SetNull)
  cameramanId    String?
  cameraman      Member? @relation("cameraman", fields: [cameramanId], references: [id], onDelete: SetNull)
  editorId       String?
  editor         Member? @relation("editor", fields: [editorId], references: [id], onDelete: SetNull)
  publisherId    String?
  publisher      Member? @relation("publisher", fields: [publisherId], references: [id], onDelete: SetNull)

  // Script stage
  scriptBody        String?
  scriptSubmittedAt DateTime?
  scriptApprovedAt  DateTime?

  // Shoot stage
  shootDate        DateTime?
  shootLocation    String?
  shootNotes       String?
  shootCompletedAt DateTime?
  footageUrl       String?

  // Edit stage
  editBrief       String?
  editStartedAt   DateTime?
  editSubmittedAt DateTime?
  editApprovedAt  DateTime?
  editUrl         String?

  // Posting stage
  platform     String?
  caption      String?
  hashtags     String?
  thumbnailUrl String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  publishedUrl String?

  /// How many times this piece has been sent back for changes.
  revisions Int     @default(0)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ContentEvent[]

  @@unique([agencyId, ref])
  @@index([clientId, monthKey])
  @@index([agencyId, stage])
}

/// A month's pay, frozen at the moment the CEO approves it. Rates and delivery
/// counts are copied in, so changing someone's rate later never rewrites what
/// they were already paid. Months without a row are still an open estimate.
model Payout {
  id       String @id @default(cuid())
  agencyId String
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  monthKey String

  payType    String
  deliveries Int
  rate       Int
  salary     Int
  /// Bonus (positive) or deduction (negative), with the reason in `note`.
  adjustment Int     @default(0)
  note       String?
  amount     Int

  status     String    @default("approved") // approved | paid
  approvedAt DateTime  @default(now())
  approvedBy String?
  paidAt     DateTime?

  @@unique([memberId, monthKey])
  @@index([agencyId, monthKey])
}

/// A signed-in browser. The id is the SHA-256 of the cookie value, so a leaked
/// database can't be used to impersonate anyone.
model Session {
  id        String   @id
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
}

/// Append-only activity log, so the CEO can see what happened and when.
model ContentEvent {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  /// created | stage | revision | assign | note | publish
  kind      String
  message   String
  actor     String?
  createdAt DateTime @default(now())

  @@index([contentId])
}
