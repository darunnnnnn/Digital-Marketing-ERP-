# Local development (a file on your machine)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# Real database (Postgres). Set both, and change `provider` in
# prisma/schema.prisma to "postgresql".
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"   # pooled, used by the app
# DIRECT_URL="postgresql://user:password@host/db?sslmode=require"     # direct, used by migrations
